<Window x:Class="SkyMasterATC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyMaster ATC"
        Height="600" Width="900"
        MinHeight="400" MinWidth="640"
        Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── Status bar (top) ───────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator"
                             Width="12" Height="12"
                             Fill="#F38BA8"
                             Margin="4,0,8,0"
                             ToolTip="Connection state"/>
                    <TextBlock x:Name="StatusLabel"
                               Style="{StaticResource StatusLabelStyle}"
                               Text="Not Connected"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ConnectButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Content="Connect"
                            Click="ConnectButton_Click"
                            Margin="4,0"/>
                    <Button x:Name="DisconnectButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Content="Disconnect"
                            Click="DisconnectButton_Click"
                            IsEnabled="False"
                            Margin="4,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Radar display placeholder (centre) ─────────────────────────────── -->
        <Border Background="#11111B"
                Margin="8"
                CornerRadius="4">
            <TextBlock Text="Radar Display — Phase 3"
                       Foreground="#585B70"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="18"/>
        </Border>
    </DockPanel>
</Window>
